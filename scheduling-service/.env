# Banco de dados
DB_NAME=scheduling_db
DB_URL=jdbc:mysql://localhost:3306/scheduling_db
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=com.mysql.cj.jdbc.Driver

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_AGENDAMENTO_EVENTOS=agendamento-eventos

# JWT
JWT_SECRET=troque-esta-chave-em-producao
JWT_ISSUER=scheduling-service
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Logging
LOG_LEVEL=INFO