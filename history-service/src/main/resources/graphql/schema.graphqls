"""Consultas disponibilizadas pelo servico de historico."""
type Query {
  """Lista o historico completo ou somente as consultas futuras de um paciente."""
  appointmentHistory(
    patientId: ID!
    futureOnly: Boolean! = false
  ): [AppointmentHistoryItem!]!
}

"""Representacao inicial de uma consulta no historico do paciente."""
type AppointmentHistoryItem {
  appointmentId: ID!
  patientId: ID!
  doctorId: ID
  """Data e hora ISO-8601 com offset, por exemplo 2026-09-01T13:00:00-03:00."""
  scheduledAt: String!
  """Status textual ate que os valores sejam acordados com o Agendamento."""
  status: String!
}
